// Vaulty data model. The server stores ONLY opaque encrypted blobs.
// It never sees plaintext item data, the master password, or the vault key.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  // Server-side hash of the ACCOUNT password (argon2/bcrypt). Proves identity
  // only; it can never decrypt vault data.
  accountHash String
  // The following KDF + check-blob fields are all set during master-password
  // onboarding (a step after signup), so they are null until then. A user with
  // a null kdfSalt has not yet set up their vault.
  //
  // Per-user salt (base64) used client-side to derive the master key. Public by
  // design: a salt is not a secret, it only prevents precomputation.
  kdfSalt     String?
  // Which KDF + parameters were used, so derivation stays reproducible even if
  // defaults change later. e.g. kdfName = "argon2id".
  kdfName     String?
  kdfParams   Json?
  // "Check blob": ciphertext + iv that only decrypts if the derived master key
  // is correct. Master-password correctness is verified client-side against
  // this, never by sending anything to the server.
  verifyBlob  String?
  verifyIv    String?
  // Non-sensitive client preferences (auto-lock timeout, clipboard clear, etc.).
  settings    Json        @default("{}")
  // Optional server-side login allowlist. Empty = accept any source IP.
  // Entries are CIDR ranges (e.g. "203.0.113.4/32", "10.0.0.0/8").
  ipAllowlist String[]    @default([])
  // Base32 TOTP secret (RFC 6238). Null when 2FA is not enrolled.
  totpSecret  String?
  // True once the user has confirmed enrollment with a valid code.
  totpEnabled Boolean     @default(false)
  // Per-user RSA-OAEP-4096 keypair used to wrap shared-vault keys. The
  // public key is safe to expose (other users need it to invite this user);
  // the private key is stored ONLY as ciphertext under the master key, so
  // the server can never decrypt anything it wraps. Lazy: generated the
  // first time the user touches a shared vault, so existing accounts are
  // unaffected until they opt in.
  publicKey            String? // base64 SPKI
  wrappedPrivateKey    String? // base64 AES-GCM ciphertext of the PKCS8 key
  wrappedPrivateKeyIv  String? // base64 IV for wrappedPrivateKey
  keypairAlg           String? // e.g. "rsa-oaep-4096"
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       VaultItem[]
  shares      Share[]
  sessions    Session[]
  auditEvents AuditEvent[]
  passkeys    PasskeyCredential[]
  vaultsOwned     SharedVault[]        @relation("SharedVaultOwner")
  memberships     SharedVaultMembership[]
  invitesSent     SharedVaultInvite[]  @relation("SharedVaultInviteSender")
  linksSent       SharedVaultInviteLink[] @relation("SharedVaultLinkSender")
  pendingWraps    SharedVaultPendingWrap[]
}

// WebAuthn credential registered by a user. `publicKey` and `counter` are the
// server's authoritative record; every future assertion is verified against
// them. `credentialId` is the browser-visible handle.
model PasskeyCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // base64url-encoded credential id from the authenticator
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String[] @default([])
  label        String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@index([userId])
}

model VaultItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable link to a shared vault. Null = personal item, encrypted under
  // the owner's master key. Non-null = shared item, encrypted under the
  // SharedVault's symmetric key (which is wrapped per-member).
  sharedVaultId String?
  sharedVault   SharedVault? @relation(fields: [sharedVaultId], references: [id], onDelete: Cascade)
  // Plaintext category hint for list rendering/icons only (e.g. "login",
  // "note"). All actual field values (including the title) live encrypted
  // inside `cipher`. Same tradeoff Bitwarden makes.
  type      String
  cipher    String   // base64 AES-GCM ciphertext of the full item payload
  iv        String   // base64 12-byte per-item random IV
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history VaultItemHistory[]

  @@index([userId])
  @@index([sharedVaultId])
}

// Prior versions of an item, snapshotted every time it is updated. Stores the
// same encrypted cipher/iv shape as VaultItem, so the server still never sees
// plaintext. Bounded by the API layer (recent-N unpinned per item) to cap
// growth; pinned rows are the user's manually-saved checkpoints and are
// never auto-pruned.
model VaultItemHistory {
  id        String   @id @default(cuid())
  itemId    String
  item      VaultItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      String
  cipher    String
  iv        String
  savedAt   DateTime @default(now())
  // True for user-initiated snapshots ("Save version" button). False (the
  // default) for auto snapshots taken on every save. Prune logic skips
  // pinned rows so a checkpoint stays around across many auto edits.
  pinned    Boolean  @default(false)
  // Optional user label for the checkpoint (e.g. "before rotating"). Stored
  // as AES-GCM ciphertext under the vault key so the server does not learn
  // what the user called it.
  label     String?
  labelIv   String?

  @@index([itemId, savedAt])
}

// Per-user audit trail: login, logout, session/allowlist changes, share
// creation, etc. Meta is opaque JSON tuned to the specific event; nothing
// sensitive is written here (no passwords, no ciphertext, no full IPs).
model AuditEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String
  meta      Json?
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Server-side session record backing the JWT cookie. Signing out or "sign
// out other devices" just deletes rows here so old JWTs stop verifying even
// if their signature is still valid.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // jti claim baked into the JWT. Random, opaque to the client.
  jti        String   @unique
  // Best-effort device hint for the sessions list.
  userAgent  String?
  // First IP octet(s), hashed. We deliberately do not store raw IPs.
  ipHash     String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId, expiresAt])
}

// A one-time, expiring share of a single item. The ciphertext is encrypted with
// a random key that lives ONLY in the share URL's fragment, so the server can
// never read it. The row is deleted the first time it is fetched.
model Share {
  id        String   @id @default(cuid())
  token     String   @unique
  cipher    String
  iv        String
  createdAt DateTime @default(now())
  expiresAt DateTime
  // Number of times this share can be opened before it self-destructs.
  // Defaults to 1 so pre-existing rows keep their original one-shot behavior.
  maxViews  Int      @default(1)
  viewCount Int      @default(0)
  // Creator so users can see and revoke their own shares. Nullable to keep
  // pre-existing rows valid; new rows always populate it.
  createdBy String?
  creator   User?    @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  // Argon2id salt (base64) when a passphrase was combined with the URL
  // fragment key. Absent = fragment key alone unlocks the ciphertext.
  passSalt  String?

  @@index([createdBy, createdAt])
}

// A shared vault holds items encrypted under a single symmetric key. That key
// is never stored on the server in the clear: each member's row in
// SharedVaultMembership holds a copy wrapped with that member's RSA public
// key, so only the member can unwrap it with their private key.
//
// The "name" is stored client-side-encrypted (name/nameIv) so the server does
// not learn how vaults are labeled.
model SharedVault {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("SharedVaultOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // AES-GCM ciphertext of the vault's display name. Decryptable only by
  // members (they all know the vault key).
  name      String
  nameIv    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  SharedVaultMembership[]
  invites      SharedVaultInvite[]
  inviteLinks  SharedVaultInviteLink[]
  pendingWraps SharedVaultPendingWrap[]
  items        VaultItem[]

  @@index([ownerId])
}

enum SharedVaultRole {
  owner
  editor
  reader
}

// A member's access to a shared vault. `wrappedKey` is the vault's symmetric
// key encrypted with the member's RSA public key. The server keeps the
// ciphertext but has no private key to decrypt it.
model SharedVaultMembership {
  id            String   @id @default(cuid())
  sharedVaultId String
  sharedVault   SharedVault @relation(fields: [sharedVaultId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          SharedVaultRole
  // Base64 RSA-OAEP ciphertext of the raw 32-byte vault key.
  wrappedKey    String
  createdAt     DateTime @default(now())

  @@unique([sharedVaultId, userId])
  @@index([userId])
}

// A signed invite link. Alternative to the email-first flow: owner creates a
// link that carries the vault, role, and expiry. Anyone who follows the link
// and is signed in can claim it, which produces a SharedVaultPendingWrap row
// waiting on the owner to complete the wrap against the recipient's public
// key. This removes the "recipient must have a keypair before you invite
// them" constraint of email-based invites.
model SharedVaultInviteLink {
  id            String   @id @default(cuid())
  sharedVaultId String
  sharedVault   SharedVault @relation(fields: [sharedVaultId], references: [id], onDelete: Cascade)
  // Random opaque token embedded in the URL. Not a JWT: rows are the source
  // of truth so revoke = delete row and there's no need to blacklist a
  // signature.
  token         String   @unique
  role          SharedVaultRole
  invitedBy     String
  sender        User     @relation("SharedVaultLinkSender", fields: [invitedBy], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  maxUses       Int      @default(1)
  useCount      Int      @default(0)
  claims        SharedVaultPendingWrap[] @relation("SharedVaultPendingWrapSource")

  @@index([sharedVaultId])
  @@index([expiresAt])
}

// A claim on an invite link: the recipient has followed the link and signed
// in but the owner has not yet wrapped the vault key against their public
// key. Owner completes the wrap through /api/vaults/[id]/pending-wraps/...
model SharedVaultPendingWrap {
  id            String   @id @default(cuid())
  sharedVaultId String
  sharedVault   SharedVault @relation(fields: [sharedVaultId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          SharedVaultRole
  // Which link produced this claim. Kept for audit + so the owner can see
  // where a stranger came from. Null if the link was later revoked or
  // deleted (SET NULL, not cascade — the claim stays valid until the owner
  // completes or denies it).
  sourceLinkId  String?
  sourceLink    SharedVaultInviteLink? @relation("SharedVaultPendingWrapSource", fields: [sourceLinkId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@unique([sharedVaultId, userId])
  @@index([userId])
}

// An invitation sent by email before the recipient has accepted. Once accepted
// it is deleted and a SharedVaultMembership row takes its place.
//
// The wrapped-key ciphertext is generated at INVITE time using the recipient's
// current public key. If they had no keypair yet, the inviter cannot invite
// them until they have signed in and enrolled a public key (client-side check
// backed by a server 409). This keeps the server free of "unwrapped-yet"
// state.
model SharedVaultInvite {
  id            String   @id @default(cuid())
  sharedVaultId String
  sharedVault   SharedVault @relation(fields: [sharedVaultId], references: [id], onDelete: Cascade)
  // Recipient's email at invite time. Lowercased for a case-insensitive match.
  email         String
  role          SharedVaultRole
  // Base64 RSA-OAEP ciphertext of the raw vault key, wrapped against the
  // recipient's public key at invite time.
  wrappedKey    String
  invitedBy     String
  sender        User     @relation("SharedVaultInviteSender", fields: [invitedBy], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@unique([sharedVaultId, email])
  @@index([email])
  @@index([expiresAt])
}
