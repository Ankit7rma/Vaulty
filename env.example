# Vaulty environment template.
# Copy to `.env` for local dev:  cp env.example .env
# The real `.env` is gitignored and must never be committed.

# --- Database (Prisma) ---
# Matches the docker-compose Postgres service. For production, use the Neon
# pooled connection string.
DATABASE_URL="postgresql://vaulty:vaulty@localhost:5432/vaulty?schema=public"

# --- Auth / session ---
# Secret used to sign session JWTs (identity only; never touches vault crypto).
# Generate one with:  openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# Session lifetime in hours (optional).
SESSION_TTL_HOURS="12"
